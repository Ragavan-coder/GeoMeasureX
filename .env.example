# ==============================================
# GeoMeasureX Configuration
# ==============================================

# Environment: development | staging | production
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./geomeasurex.db

# For production (PostgreSQL/PostGIS):
# DATABASE_URL=postgresql://user:password@localhost:5432/geomeasurex

# File Upload
MAX_UPLOAD_SIZE_MB=50
TEMP_DIRECTORY=./temp
UPLOAD_DIRECTORY=./uploads

# Logging
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (CORS)
FRONTEND_URL=http://localhost:5173

# Measurement Precision
MEASUREMENT_DECIMAL_PLACES=6
API_DISPLAY_DECIMAL_PLACES=2
